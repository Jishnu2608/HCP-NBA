# Copy to .env (never commit .env). Every value is optional; defaults suit a local demo.

# --- Email delivery of one-time verification codes ---
# When NBA_SMTP_HOST is set, sign-up codes are emailed and are never shown on screen.
# When it is not set and NBA_DEMO_MODE is true, the code is shown in a development box.
# Use an app password from your mail provider, not your account password.
# NBA_SMTP_HOST=smtp.gmail.com
# NBA_SMTP_PORT=587
# NBA_SMTP_USER=you@example.com
# NBA_SMTP_PASSWORD=your-app-password
# NBA_SMTP_FROM=Next Best Action <you@example.com>

# Invitation emails (professional roles) use the same mail settings. Links in emails start
# with NBA_PUBLIC_BASE_URL: set it to your LAN address (http://192.168.x.x:8000) to open
# invitation links on a phone.
# NBA_PUBLIC_BASE_URL=http://localhost:8000
# NBA_SUPPORT_EMAIL=help@example.com   # contact shown in emails; defaults to the sender
# NBA_INVITATION_TTL_HOURS=72

# --- Demo conveniences ---
# NBA_DEMO_MODE=true              # allows on-screen codes / invitation links, local runs only,
#                                 # and only when no mail server is set
# NBA_SEED_DEMO_ACCOUNTS=true     # false = seed only the administrator

# --- Security ---
# NBA_ENVIRONMENT=local           # anything else: Secure cookies, HSTS, no API docs,
#                                 # no on-screen codes
# NBA_SESSION_IDLE_MINUTES=60
# NBA_ACCESS_TOKEN_MINUTES=480    # absolute session lifetime
# NBA_ALLOWED_ORIGINS=   # Vite dev server
# NBA_MINOR_AGE=18                # under this age: patient flagged as minor, professional refused

# --- Legal documents (facts only the operator can supply) ---
# Unset values show as "[To be confirmed]" in the Privacy Policy and Terms.
# NBA_LEGAL_CONTROLLER_NAME=
# NBA_LEGAL_CONTROLLER_ADDRESS=
# NBA_LEGAL_PRIVACY_EMAIL=
# NBA_LEGAL_DPO_CONTACT=
# NBA_LEGAL_EU_REPRESENTATIVE=
# NBA_LEGAL_GOVERNING_LAW=
# NBA_LEGAL_HOSTING_REGION=
# NBA_PRIVACY_RESPONSE_DAYS=
# NBA_ALLOW_EXTERNAL_IDENTIFIABLE_DATA=false   # external drafting providers get no names

# --- Shared AI layer (app/ai; synthetic-data prototype, see docs/ai-architecture.md) ---
# Provider is chosen here, on the server only. There is no automatic fallback between
# providers: if the chosen one is off or fails, the operation shows its deterministic template.
# NBA_AI_PROVIDER=ollama                    # ollama (default) | off. "cloud" is refused in
#                                           # this phase: nothing is ever sent to a cloud API.
# Local model through Ollama on this machine (loopback only; cloud model tags are refused).
# Start Ollama with OLLAMA_NO_CLOUD=1 so it cannot reach Ollama's hosted models either.
# NBA_AI_OLLAMA_BASE_URL=http://127.0.0.1:11434
# NBA_AI_OLLAMA_MODEL=qwen3.5:9b-q4_K_M
# NBA_AI_TIMEOUT_SECONDS=180
# Case Brief: template (default, no model call) | shadow (model runs and is audited, readers
# see the template) | prototype (readers see checked model wording, marked for review).
# NBA_AI_CASE_BRIEF_MODE=template
# NBA_AI_MAX_ACTIVE_JOBS=2                  # AI generations queued or running at once
# NBA_AI_KEEP_GENERATIONS=5                 # generation rows kept per patient (audit stays)
# Cloud settings are kept for a later, reviewed phase and are ignored now.
# NBA_AI_CLOUD_VENDOR=
# NBA_AI_CLOUD_MODEL=
# NBA_AI_CLOUD_BASE_URL=
# NBA_AI_CLOUD_API_KEY_ENV=                 # NAME of a variable, never a key

# --- Required secrets (no defaults in code) ---
# `python -m app.bootstrap` (run from backend/) creates these with random values if
# they are missing. To choose your own or change them later, set them here, then run
# `python -m app.auth.rotate` so the accounts in the database use them, and restart.
# NBA_JWT_SECRET=
# NBA_ADMIN_PASSWORD=
# NBA_DEMO_PASSWORD=
# NBA_ADMIN_EMAIL=

# --- Other ---
# POSTGRES_PASSWORD=            # only for docker-compose
# NBA_DATABASE_URL=
